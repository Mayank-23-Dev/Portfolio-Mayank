{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "noEmit": true,
    "noCheck": true,
    "strict": false,
    "skipLibCheck": true,
    "allowJs": true,
  },
  "include": ["vite.config.js"]
}
